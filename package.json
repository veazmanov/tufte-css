{
  "name": "tufte-css-vjbe",
  "version": "2.0.0",
  "description": "Tufte CSS provides tools to style web articles using the ideas demonstrated by Edward Tufte’s books and handouts. Edward Tufte uses a distinctive style in his handouts: simple, with well-set typography, extensive sidenotes, and tight integration of graphics and charts.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veazmanov/tufte-css.git"
  },
  "keywords": [
    "tufte",
    "css",
    "HTML",
    "typography",
    "sidenotes"
  ],
  "author": "Dave Liepmann",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/veazmanov/tufte-css/issues"
  },
  "homepage": "https://tufte.vjbe.net/",
  "scripts": {
    "build": "cleancss -o tufte.min.css tufte.css",
    "test": "npm run build && playwright test",
    "release": "npm run build && ./release.sh"
  },
  "files": [
    "tufte.css",
    "tufte.min.css",
    "et-book/",
    "theme.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "clean-css-cli": "^5.6.3"
  },
  "private": true,
  "contributors": [
    "Victor Elgersma-Azmanov (vjbe fork)"
  ]
}
